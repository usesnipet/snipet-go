{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAG Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "milvus": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "description": "The address of the Milvus server"
        },
        "dimension": {
          "type": "number",
          "description": "The dimension of the vectors"
        },
        "username": {
          "type": "string",
          "description": "The username for the Milvus server"
        },
        "password": {
          "type": "string",
          "description": "The password for the Milvus server"
        },
        "dbName": {
          "type": "string",
          "description": "The name of the database to use"
        },
        "apiKey": {
          "type": "string",
          "description": "The API key for the Milvus server"
        },
        "collectionName": {
          "type": "string",
          "description": "The name of the collection to use"
        }
      },
      "required": [
        "address",
        "dimension",
        "dbName"
      ]
    },
    "chunker": {
      "type": "object",
      "properties": {
        "chunkSize": {
          "type": "number",
          "description": "The size of the chunks"
        },
        "overlap": {
          "type": "number",
          "description": "The overlap of the chunks"
        },
        "minChunkSize": {
          "type": "number",
          "description": "The minimum size of the chunks"
        },
        "trimWhitespace": {
          "type": "boolean",
          "description": "Whether to trim whitespace from the chunks"
        },
        "separators": {
          "type": "array",
          "description": "The separators to use for the chunks",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "chunkSize",
        "overlap"
      ]
    },
    "embedder": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "description": "The model to use for the embeddings"
        },
        "apiKey": {
          "type": "string",
          "description": "The API key for the embedder"
        }
      },
      "required": [
        "model",
        "apiKey"
      ]
    }
  },
  "required": [

  ]
}