{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Set Configuration",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the tool"
          },
          "description": {
            "type": "string",
            "description": "Description of the tool"
          },
          "parameters": {
            "type": "object",
            "description": "Dynamic map of parameters (key: string, value: any type)",
            "additionalProperties": true
          }
        }
      }
    }
  }
}